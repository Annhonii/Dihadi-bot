# Telegram Bot Token (Get this from @BotFather on Telegram)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional: Restrict bot usage to specific Telegram User IDs (comma-separated)
# Leave blank to make the bot public for everyone
ALLOWED_USERS=

# Maximum file size in MB (Default Telegram Bot API limit is 50MB)
MAX_FILE_SIZE_MB=50
